{
  "name": "tickety",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Coffee shop order number display",
  "author": {
    "name": "Herco Bezuidenhout",
    "email": "hercobez@icloud.com"
  },
  "homepage": "https://github.com/hercobezuidenhout/tickety",
  "build": {
    "appId": "com.hercobezuidenhout.tickety",
    "productName": "Tickety",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
