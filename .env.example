# Copy to .env and edit. Vite only exposes variables prefixed with VITE_.
# Values are read when `npm run dev` starts or `npm run build` runs, so
# restart the dev server / rebuild after changing them.

# Timing and limits
VITE_EXPIRY_SECONDS=300
VITE_MAX_PAST_ORDERS=8
VITE_SERVING_COLUMNS=5

# Labels
VITE_SERVING_LABEL=Now serving
VITE_PAST_LABEL=Past orders

# Visibility (true / false). A hidden input still receives the keypad.
VITE_SHOW_TIMER=true
VITE_SHOW_INPUT=true

# Colours (any CSS colour)
VITE_COLOR_BACKGROUND=#ffffff
VITE_COLOR_TEXT=#0f172a
VITE_COLOR_ACCENT=#34d399
VITE_COLOR_ACCENT_TEXT=#ffffff
VITE_COLOR_BORDER=#e2e8f0
